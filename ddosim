        kfmt = _c(f"{k:<{width}}", _Ansi.DIM)
        vfmt = _c(str(v), _Ansi.BOLD)
        print(f"{kfmt} : {vfmt}")
    print()


# ------------------------------- Help/CLI UX ---------------------------------
class ColorHelpFormatter(_argparse.RawTextHelpFormatter):
    def _color(self, s, style):
        return _c(s, style) if "ENABLE_COLOR" in globals() and ENABLE_COLOR else s

    def _get_help_string(self, action):
        """
        Inject *effective* defaults into the help text, instead of argparse's
        raw action.default (which is usually None for our CLI).
        """
        help_text = action.help or ""

        # Map CLI dest -> effective default from CONFIG / DEFAULTS / env
        effective_defaults = {
            "devs": CONFIG.get("num_devs", DEFAULTS["num_devs"]),
            "time": CONFIG.get(
                "emulation_time_sec", DEFAULTS["emulation_time_sec"]
            ),
            "network": CONFIG.get(
                "network_type", DEFAULTS["network_type"]
            ),
            "churn": CONFIG.get(
                "churn_mode", DEFAULTS["churn_mode"]
            ),
            "log": CONFIG.get(
                "ns3_file_log_mode", DEFAULTS["ns3_file_log_mode"]
            ),
            "size": CONFIG.get(
                "scenario_size_meters", DEFAULTS["scenario_size_meters"]
            ),
            "jobs": CONFIG.get(
                "build_jobs", DEFAULTS["build_jobs"]
            ),
            "destroy_scope": CONFIG.get(
                "destroy_scope", DEFAULTS["destroy_scope"]
            ),
            "app": CONFIG.get(
                "dev_app", DEFAULTS["dev_app"]
            ),
        }

        # Special cases that don't live in CONFIG
        if action.dest == "verbosity":
            eff_default = os.getenv("DDOSIM_VERBOSITY", "quiet")
        elif action.dest == "color":
            eff_default = "auto"
        else:
            eff_default = effective_defaults.get(action.dest)

        # Only append a default if we actually know it, and the help text
        # doesn't already mention %(default)s explicitly.
        if eff_default is not None and "%(default)" not in help_text:
            help_text += f" (default: {eff_default})"

        return help_text

    def format_help(self):
        text = super().format_help()

        text = text.replace(
            "usage:",
            self._color("USAGE", _Ansi.FG_CYN + _Ansi.BOLD),
        )
        text = text.replace(
            "positional arguments:",
            self._color("COMMAND", _Ansi.FG_BLU + _Ansi.BOLD),
        )
        text = text.replace(
            "optional arguments:",
            self._color("OPTIONS", _Ansi.FG_BLU + _Ansi.BOLD),
        )
        text = text.replace(
            "options:",
            self._color("OPTIONS", _Ansi.FG_BLU + _Ansi.BOLD),
        )

        lines = []
        for ln in text.splitlines():
            if ln.strip().startswith("-") and ln.strip().endswith(":"):
                lines.append(ln)
            else:
                lines.append(ln)
        return "\n".join(lines)


class DDoSimArgumentParser(_argparse.ArgumentParser):
    def error(self, message):
        msg = (
            _c(f"error: {message}", _Ansi.FG_RED + _Ansi.BOLD)
            if ENABLE_COLOR
            else f"error: {message}"
        )
        self.print_usage()
        self.exit(2, msg + "\n\n" + self.format_help())



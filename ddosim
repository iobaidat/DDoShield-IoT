class _Ansi:
    RESET = "\x1b[0m"
    BOLD = "\x1b[1m"
    DIM = "\x1b[2m"
    FG_RED = "\x1b[31m"
    FG_GRN = "\x1b[32m"
    FG_YEL = "\x1b[33m"
    FG_BLU = "\x1b[34m"
    FG_CYN = "\x1b[36m"
    FG_GRY = "\x1b[90m"


def _supports_color() -> bool:
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def _conn_verbose_flag() -> str:
